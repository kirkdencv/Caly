# Copy this file to backend/.env, then replace the placeholder locally.
# Never commit backend/.env or a real API key.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
# Comma-separated browser origins. Do not include a path or trailing slash.
CALY_ALLOWED_ORIGINS=https://your-flutter-site.example
